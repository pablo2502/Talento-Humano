# Copia este archivo como .env y cambia los valores
DB_NAME=talentodb
DB_USER=talento
DB_PASSWORD=talento123
DB_ROOT_PASSWORD=root123
# Genera uno con: openssl rand -base64 32
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres

# Puertos (en el servidor normalmente FRONTEND_PORT=80)
FRONTEND_PORT=8090
BACKEND_PORT=8080

# Usuario de Docker Hub (para docker-compose.prod.yml)
DOCKERHUB_USER=tu-usuario
